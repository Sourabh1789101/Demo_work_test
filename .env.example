# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WS_PORT=4001

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_builder

# ─── Redis (optional — falls back to in-memory mock) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (REQUIRED in production) ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_use_32_random_chars
JWT_REFRESH_SECRET=change_me_different_from_jwt_secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Encryption (AES-256-GCM for PII fields) ─────────────────────────────────
# Must be exactly 64 hex chars (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourapp.com

# ─── Stripe (Payment Integration) ────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── GDPR ─────────────────────────────────────────────────────────────────────
DPO_EMAIL=privacy@yourapp.com

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme

# ─── AWS S3 (File Uploads — optional) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
