# API Environment Configuration (LOCAL DEVELOPMENT ONLY)
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16)
# Local: postgresql://postgres:postgres@localhost:5432/form_builder
# With Docker Compose: postgresql://postgres:postgres@postgres:5432/form_builder
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_builder

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_32_random_characters
JWT_REFRESH_SECRET=change_me_to_different_32_random_characters

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Gemini API (for AI Form Generation)
# Get your API key from: https://ai.google.dev/
# Model options: gemini-2.0-flash (fastest, recommended), gemini-1.5-pro (most powerful), gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI API (legacy - no longer used, kept for reference)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Stripe (optional - leave blank to disable payment endpoints)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GDPR
DPO_EMAIL=privacy@example.com
