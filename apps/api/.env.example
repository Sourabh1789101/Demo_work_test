# API Environment Configuration
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16)
# Local: postgresql://postgres:postgres@localhost:5432/form_builder
# NeonDB: postgresql://user:password@ep-xxx.neon.tech/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_builder

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_32_random_characters
JWT_REFRESH_SECRET=change_me_to_different_32_random_characters

# AI Form Generation (NVIDIA NIM - Free)
# Get from: https://build.nvidia.com
# Sign up for free → Get API key from build.nvidia.com/meta/llama-3-1-405b-instruct
NVIDIA_NIM_API_KEY=nvapi-your-api-key-here

# Stripe Payments (Optional)
# Get from: https://stripe.com/dashboard
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Redis (Optional - falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379

# CORS & Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@formbuilder.com

# Data Protection Officer Email (GDPR)
DPO_EMAIL=privacy@example.com

# Encryption Key (Optional - auto-generated if missing)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-hex-characters-for-aes-256-gcm

# Grafana Monitoring (Optional)
GRAFANA_PASSWORD=changeme
