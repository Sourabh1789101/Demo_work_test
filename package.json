{
  "name": "form-builder-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,ws \"npm run dev -w apps/web\" \"npm run dev -w apps/api\" \"npm run dev -w apps/websocket\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:ws": "npm run dev -w apps/websocket",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.5.6"
  }
}
