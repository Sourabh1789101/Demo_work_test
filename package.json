{
  "name": "formbuilder-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "terser": "^5.46.1",
    "turbo": "^2.5.6"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "next-auth": "^4.24.13"
  }
}
